From: devjo <devjo@localhost>
Subject: [PATCH] finder-app: use target compiler, PATH and installed configuration

Keep the published Assignment 4 Part 1 source revision reproducible while
Part 2 source changes await review and push. These changes match the local
source repository working tree.

Signed-off-by: devjo <devjo@localhost>
---
--- a/finder-app/Makefile
+++ b/finder-app/Makefile
@@ -1,12 +1,16 @@
-CC = $(CROSS_COMPILE)gcc # selects compiler
-CFLAGS = -Wall -Wextra # keeps compiler warnings enabled
+# Honor CC supplied by Buildroot or the caller. GNU make otherwise defaults
+# CC to cc; retain CROSS_COMPILE support for the earlier assignments.
+ifeq ($(origin CC),default)
+CC = $(CROSS_COMPILE)gcc
+endif
+CFLAGS ?= -Wall -Wextra
 
-all: writer # build the writer app by default
+all: writer
 
-writer: writer.c # writer depends on writer.c and runs executable
-	$(CC) $(CFLAGS) -o writer writer.c
+writer: writer.c
+	$(CC) $(CPPFLAGS) $(CFLAGS) $(LDFLAGS) -o $@ $< $(LDLIBS)
 
-clean: # removes executable and files ending in .o from current folder
+clean:
 	rm -f writer *.o
 
-.PHONY: all clean # prevents a file named clean from blocking cleanup
+.PHONY: all clean
--- a/finder-app/finder-test.sh
+++ b/finder-app/finder-test.sh
@@ -2,13 +2,16 @@
 # Tester script for assignment 1 and assignment 2
 # Author: Siddhant Jajoo
 
-set -e
-set -u
+# Capture the complete test output while preserving the test exit status.
+run_test() (
+set -eu
 
 NUMFILES=10
 WRITESTR=AELD_IS_FUN
 WRITEDIR=/tmp/aeld-data
-username=$(cat conf/username.txt)
+# Native regression tests may override this; the target uses /etc by default.
+CONFDIR=${FINDER_APP_CONF_DIR:-/etc/finder-app/conf}
+username=$(cat "$CONFDIR/username.txt")
 
 if [ $# -lt 3 ]
 then
@@ -32,9 +35,9 @@
 rm -rf "${WRITEDIR}"
 
 # create $WRITEDIR if not assignment1
-assignment=`cat conf/assignment.txt`
+assignment=$(cat "$CONFDIR/assignment.txt")
 
-if [ $assignment != 'assignment1' ]
+if [ "$assignment" != 'assignment1' ]
 then
 	mkdir -p "$WRITEDIR"
 
@@ -48,22 +51,19 @@
 		exit 1
 	fi
 fi
-#echo "Removing the old writer utility and compiling as a native application"
-#make clean
-#make
 
-for i in $( seq 1 $NUMFILES)
+for i in $(seq 1 "$NUMFILES")
 do
-	./writer "$WRITEDIR/${username}$i.txt" "$WRITESTR"
+	writer "$WRITEDIR/${username}$i.txt" "$WRITESTR"
 done
 
-OUTPUTSTRING=$(./finder.sh "$WRITEDIR" "$WRITESTR")
+OUTPUTSTRING=$(finder.sh "$WRITEDIR" "$WRITESTR")
 
 # remove temporary directories
 rm -rf /tmp/aeld-data
 
 set +e
-echo ${OUTPUTSTRING} | grep "${MATCHSTR}"
+printf '%s\n' "$OUTPUTSTRING" | grep -F "$MATCHSTR"
 if [ $? -eq 0 ]; then
 	echo "success"
 	exit 0
@@ -71,3 +71,10 @@
 	echo "failed: expected  ${MATCHSTR} in ${OUTPUTSTRING} but instead found"
 	exit 1
 fi
+
+)
+
+run_test "$@" > /tmp/assignment4-result.txt 2>&1
+rc=$?
+cat /tmp/assignment4-result.txt
+exit "$rc"
